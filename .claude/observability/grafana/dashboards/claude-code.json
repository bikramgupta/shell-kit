  "description": "Claude Code telemetry (OTLP -> OTel Collector -> Prometheus). Panels match metric names by regex so they survive OTEL->Prometheus name translation (dots -> underscores, counters get _total, units appended). Adjust exprs if names shift between Claude Code versions - verify at Prometheus /graph and the monitoring-usage docs.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Cost",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum({__name__=~\"claude_code_cost_usage.*\"})",
          "legendFormat": "cost",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
